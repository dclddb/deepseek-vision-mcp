# deepseek-vision-mcp 配置示例
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）

# OpenAI 兼容 Chat 接口（full 模式，必填）
VISION_API_KEY=
VISION_API_BASE_URL=https://your-vision-api.example.com/v1
VISION_FULL_MODEL=your-vision-model

# PaddleOCR 专用 OCR 接口（ocr 模式，可选）
VISION_OCR_ENDPOINT=https://your-ocr-api.example.com/v1/paddleocr
VISION_OCR_MODEL=PaddleOCR-VL-1.5

# 缓存（可选，默认值即可）
VISION_CACHE_ENABLED=true
VISION_CACHE_SCOPE=global
VISION_CACHE_DIR=
VISION_CACHE_TTL_DAYS=30
VISION_CACHE_MAX_SIZE_MB=128

# 重试 / 超时（可选）
VISION_FALLBACK_ENABLED=false
VISION_RETRY_MAX=2
VISION_TIMEOUT=60
